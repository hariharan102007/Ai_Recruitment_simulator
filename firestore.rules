rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // PII protection: no collection queries
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email.size() <= 150;
      allow update: if isOwner(userId)
        && request.resource.data.email == resource.data.email;
      allow delete: if isOwner(userId);
    }

    // Resume Collection Rules
    match /resumes/{resumeId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(resumeId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.parsedText is string
        && request.resource.data.parsedText.size() <= 50000;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Assessment Results Rules
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(assessmentId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.stageId is string
        && request.resource.data.stageId.size() <= 50;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
